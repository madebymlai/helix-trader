# Copy to `.env` (gitignored) and fill in. Read at start by `fill-catalog`
# and `live`; a variable already set in the environment wins.

# IB login of the paper account, used by the Docker IB Gateway (IBC logs in
# with them). History always runs on paper, so these are needed whenever IB
# instruments are filled or traded.
TWS_USERNAME=
TWS_PASSWORD=

# IB account traded by `live` when `--account` is not given, for example
# DU1234567 (paper) or U1234567 (live).
NAUTILUS_IB_ACCOUNT_ID=

# Docker API socket. Here `docker` is podman: point to the user's podman
# socket, since /var/run/docker.sock is root's.
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock

# OKX API key, the names Nautilus' OKX adapter reads. `live` runs OKX
# instruments in the EEA region: create the key on my.okx.com, under Demo
# Trading for the demo.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX environment of the key, required: `demo` or `live`.
OKX_ENVIRONMENT=

# IC Markets on cTrader's Open API. The app's credentials from
# openapi.ctrader.com (Applications, Credentials); the access and refresh
# token and the account's ctidTraderAccountId from the app's Playground.
# The token pair only seeds the token file,
# $XDG_STATE_HOME/helix-trader/ic-token.json (by default
# ~/.local/state/helix-trader/ic-token.json, mode 0600): renewal is
# automatic and the file keeps the latest pair; this file is never written,
# and its pair is spent after the first renewal. Put a new pair here (from
# the Playground) only when cTrader refuses to renew: it seeds the file
# again.
IC_CLIENT_ID=
IC_CLIENT_SECRET=
IC_ACCESS_TOKEN=
IC_REFRESH_TOKEN=
IC_ACCOUNT_ID=
# cTrader environment of the account, required: `demo` or `live`.
IC_ENVIRONMENT=
