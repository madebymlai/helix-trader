# Copy to `.env` (gitignored) and fill in. Read at start by `fill-catalog`
# and `live`; a variable already set in the environment wins.

# IB login of the paper account, used by the Docker IB Gateway (IBC logs in
# with them). History always runs on paper, so these are always needed.
TWS_USERNAME=
TWS_PASSWORD=

# IB account traded by `live` when `--account` is not given, for example
# DU1234567 (paper) or U1234567 (live).
NAUTILUS_IB_ACCOUNT_ID=

# Docker API socket. Here `docker` is podman: point to the user's podman
# socket, since /var/run/docker.sock is root's.
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
