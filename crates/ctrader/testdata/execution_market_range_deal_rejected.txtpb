# Captured from a cTrader broker's demo (2026-11-16), protobuf port 5035:
# that MARKET_RANGE order cancelled unfilled, its deal rejected by the
# server (INTERNALLY_REJECTED) with release 100's rejectReason. An order
# cTrader refuses at execution comes as ORDER_CANCELLED with the rejected
# deal, not as ORDER_REJECTED.
# Scrubbed: ctidTraderAccountId replaced by the fake 1000001; re-encoded
# from the decoded event, fields as served.
# The .bin is the payload; this is its text form, from:
#   protoc -I ../proto --decode=ProtoOAExecutionEvent OpenApiMessages.proto < execution_market_range_deal_rejected.bin
# Message: ProtoOAExecutionEvent
ctidTraderAccountId: 1000001
executionType: ORDER_CANCELLED
position {
  positionId: 696911475
  tradeData {
    symbolId: 41
    volume: 0
    tradeSide: BUY
    guaranteedStopLoss: false
    measurementUnits: "Oz"
  }
  positionStatus: POSITION_STATUS_CLOSED
  swap: 0
  price: 0
  commission: 0
  marginRate: 0
  mirroringCommission: 0
  guaranteedStopLoss: false
  usedMargin: 0
  moneyDigits: 2
}
order {
  orderId: 1040620401
  tradeData {
    symbolId: 41
    volume: 100
    tradeSide: BUY
    openTimestamp: 1794842122732
    guaranteedStopLoss: false
    measurementUnits: "Oz"
    closeTimestamp: 1794842122943
  }
  orderType: MARKET_RANGE
  orderStatus: ORDER_STATUS_CANCELLED
  executedVolume: 0
  utcLastUpdateTimestamp: 1794842122943
  baseSlippagePrice: 3868.88
  slippageInPoints: 0
  closingOrder: false
  clientOrderId: "PROBE-REJECT-1"
  timeInForce: IMMEDIATE_OR_CANCEL
  positionId: 696911475
}
deal {
  dealId: 961256684
  orderId: 1040620401
  positionId: 696911475
  volume: 100
  filledVolume: 0
  symbolId: 41
  createTimestamp: 1794842122732
  executionTimestamp: 1794842122943
  utcLastUpdateTimestamp: 1794842122943
  tradeSide: BUY
  dealStatus: INTERNALLY_REJECTED
  marginRate: 3518.04
  commission: 0
  baseToUsdConversionRate: 3873.88
  moneyDigits: 2
  rejectReason: "Market VWAP is worse than Limit price"
}
isServerEvent: false
